<?xml version="1.0" encoding="utf-8"?>
<edmx:Edmx Version="1.0" xmlns:edmx="http://schemas.microsoft.com/ado/2007/06/edmx">
  <edmx:DataServices m:DataServiceVersion="2.0" xmlns:m="http://schemas.microsoft.com/ado/2007/08/dataservices/metadata">
    <Schema Namespace="FlowproofFixture" xmlns="http://schemas.microsoft.com/ado/2008/09/edm">

      <EntityType Name="Supplier">
        <Key><PropertyRef Name="SupplierID"/></Key>
        <Property Name="SupplierID" Type="Edm.String" Nullable="false"/>
        <Property Name="Name" Type="Edm.String"/>
        <Property Name="City" Type="Edm.String"/>
        <Property Name="Status" Type="Edm.String"/>
        <Property Name="Balance" Type="Edm.Decimal" Precision="12" Scale="2"/>
        <Property Name="Email" Type="Edm.String"/>
        <Property Name="Country" Type="Edm.String"/>
        <Property Name="FoundedOn" Type="Edm.DateTime"/>
        <Property Name="Active" Type="Edm.Boolean"/>
        <Property Name="PreferredProductID" Type="Edm.String"/>
      </EntityType>

      <EntityType Name="Product">
        <Key><PropertyRef Name="ProductID"/></Key>
        <Property Name="ProductID" Type="Edm.String" Nullable="false"/>
        <Property Name="Name" Type="Edm.String"/>
        <Property Name="Category" Type="Edm.String"/>
      </EntityType>

      <EntityContainer Name="FlowproofFixture_Entities" m:IsDefaultEntityContainer="true">
        <EntitySet Name="Suppliers" EntityType="FlowproofFixture.Supplier"/>
        <EntitySet Name="Products" EntityType="FlowproofFixture.Product"/>
      </EntityContainer>

    </Schema>
  </edmx:DataServices>
</edmx:Edmx>
