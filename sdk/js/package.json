    "flowproof": "bin/flowproof.js"
  },
  "files": [
    "bin/flowproof.js",
    "index.js"
  ],
  "main": "index.js",
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@automators/flowproof-cli-linux-x64": "0.6.1",
    "@automators/flowproof-cli-darwin-x64": "0.6.1",
    "@automators/flowproof-cli-darwin-arm64": "0.6.1",
    "@automators/flowproof-cli-win32-x64": "0.6.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/automators-com/flowproof.git"
  },
  "homepage": "https://github.com/automators-com/flowproof",
  "keywords": [
    "test-automation",
    "testing",
    "automation",
    "ai-agents",
