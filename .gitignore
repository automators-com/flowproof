# Rust (Cargo.lock is tracked)
/target/
**/target/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Node
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-store/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Local env
.env
.env.*
!.env.example

# maturin develop artifacts
*.abi3.so
*.pyd

# Field-hardening loop scratch state (local bookkeeping, not product).
.loop/

# flowproof record/run artifacts (screenshots, GIFs, reports) — regenerated
# next to each spec, never the thing to commit. The *.trace.jsonl next to it
# is the actual test contract and is tracked.
.flowproof/

# The npm platform package assembled by .github/workflows/publish-npm.yml
# (`cargo build --release` + a generated package.json). Ephemeral on a CI
# runner, but a 20MB binary one `git add -A` away from a commit locally.
/dist-npm/

# Local presentation build workspace and rendered QA images.
/docs/slides/.build/
/docs/slides/*.pptx.inspect.ndjson
/docs/slides/flowproof-training-*/
/docs/slides/flowproof-solutions-*/
